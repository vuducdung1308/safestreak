# Verifier service — copy to .env on Render. Never commit a real .env.
# Private key ONLY from env VERIFIER_PRIVATE_KEY, never in code, never logged.
# Generate a fresh dedicated key for the verifier; never reuse a deployer key.
VERIFIER_PRIVATE_KEY=
# Public BNB Chain RPC endpoint
RPC_URL=https://bsc-dataseed.binance.org/
# SafeStreak contract address — deployed on BNB mainnet. Used to read nonces.
SAFESTREAK_ADDRESS=
# Block number of the final leaderboard snapshot (09/12/2026 08:00 UTC).
# Set after deployment, once the snapshot block is known.
SNAPSHOT_BLOCK=
# Accepted attestation tokens as a JSON map symbol -> address.
# PLACEHOLDER EXAMPLE ONLY — replace with verified BNB Chain mainnet
# token addresses before go-live. Never hardcode addresses you are unsure of.
ACCEPTED_TOKENS={"USDT":"0xPLACEHOLDER_USDT","USDC":"0xPLACEHOLDER_USDC","WBNB":"0xPLACEHOLDER_WBNB","BTCB":"0xPLACEHOLDER_BTCB","ETH":"0xPLACEHOLDER_ETH","CAKE":"0xPLACEHOLDER_CAKE"}
# Port Render assigns (Render sets PORT itself; 3000 is the local default)
PORT=3000
