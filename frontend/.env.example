# Copy to .env and fill in. Never commit a real .env with secrets.
# SafeStreak contract address — NOT deployed yet. Leave empty until deployed.
VITE_SAFESTREAK_ADDRESS=
# Agent ID contract (ERC-721, non-transferable) on BNB Chain
VITE_AGENT_ID_ADDRESS=0x60b9262456de011f7d15a54cdd8c48baaa8b022f
# Public BNB Chain RPC endpoint
VITE_RPC_URL=https://bsc-dataseed.binance.org/
# Verifier service base URL (Render), e.g. https://safestreak-verifier.onrender.com
VITE_VERIFIER_URL=
